+    int        consumed;    // 进度：到本状态为止已吃掉的音数（**不再用作分层判据**）
+    int        depth;      // 已切片的片数（束搜索的分层判据，见 SolveTechniqueTrace）
+    double     nowT;        // 本片结束后的时间
+    double     prevLen;     // 本片片长（给下一片算 rough 用）
