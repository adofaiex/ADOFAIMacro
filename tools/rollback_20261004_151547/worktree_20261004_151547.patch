+        // ——— scrPlayer.UpdateHoldKeys 越界防护 ———————————————————
+        // 游戏自身潜伏 bug（Spectre 同款 Finalizer，Patch_Playback.cs:33-43）：
+        // 命中 midspin 时 Hit() 尾部会向 keyTimes 自补一个待处理按键，方法末段
+        // midspin 分支的第二次 RemoveAt(0) 假定这个补充一定还在。若中途那次
+        // Hit() 提前返回 false（无响应窗口、忽略输入特效等），既不推进地板也不
+        // 补条目，第二次 RemoveAt(0) 就在空表上抛 ArgumentOutOfRangeException。
+        // 正常游玩几乎凑不齐触发条件；宏按量化时间注入按键（且 v3 角度驱动的
+        // 精确时间戳会挪动响应窗口边界），概率显著上升。
+        // 抛出只会中断当帧的输入模拟——宏的状态每帧由事件表驱动重算，吞掉
+        // 不影响后续帧，吞掉比让游戏崩溃安全。仅在宏播放中吞，人工游玩不拦。
+        [HarmonyPatch(typeof(scrPlayer), "UpdateHoldKeys")]
+        public static class Patch_UpdateHoldKeys_CrashGuard
+        {
+            [HarmonyFinalizer]
+            public static Exception Finalizer(Exception __exception)
+            {
+                if (__exception == null || !(__exception is ArgumentOutOfRangeException))
+                    return __exception;
+                bool macroActive = false;
+                try
+                {
+                    macroActive = Main.Settings != null
+                        && Main.Settings.SimulateKeyPress
+                        && Main.Settings.EnableTechniqueSimulation;
+                }
+                catch
+                {
+                    // 设置不可用时保守起见不吞
+                    return __exception;
+                }
+                if (!macroActive)
+                    return __exception;
+                try
+                {
+                    Main.Log("[Macro] 回放命中游戏 UpdateHoldKeys midspin keyTimes 越界（已知游戏 bug），已拦截");
+                }
+                catch
+                {
+                    // 日志失败不影响吞异常
+                }
+                return null; // 吞掉，中断的只是当帧输入模拟
+            }
+        }
