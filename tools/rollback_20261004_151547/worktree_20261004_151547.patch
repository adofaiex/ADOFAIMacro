+                && !(fwd.Flags & TRACE_FLAG_HOLD_RELATED)) {
+                pending[ev.KeyCode] = j;
+                break;
+            }
+        }
+    }
+    sort(output.begin(), output.end(),
+        [](const TraceEvent& a, const TraceEvent& b) { return a.TriggerTime < b.TriggerTime; });
+}
