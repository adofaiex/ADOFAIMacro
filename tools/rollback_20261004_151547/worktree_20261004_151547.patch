+            releaseEv.Flags = TRACE_FLAG_RELEASE_ONLY;
+            releaseEv.ReleaseKeyCode = kc;
+            releaseEv.FloorIndex = (rs < (int)ft.judgedIdx.size()) ? evFloor[ft.judgedIdx[rs]] : curFloor;
+            output.push_back(releaseEv);
+        }
+    }
