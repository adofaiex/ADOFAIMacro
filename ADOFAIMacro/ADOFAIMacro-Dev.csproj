<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK 风格项目文件（由旧式 ToolsVersion="15.0" 格式迁移而来）。

    与旧式格式的差异，以及为什么这样处理：
      · 目标框架从 <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
        改为 <TargetFramework>net481</TargetFramework>（等价）。
      · 源文件不再逐个 <Compile Include>，改由 SDK 的默认通配 **/*.cs 自动
        包含 —— 新增文件不用再回来改这里。
      · NuGet 依赖从 packages.config 改为 PackageReference。包会落到全局缓存，
        不再需要仓库里携带 packages\ 目录。
      · 程序集元数据（版本 / Guid / ComVisible）从 Properties\AssemblyInfo.cs
        移到这里，并由 <GenerateAssemblyInfo> 统一生成 —— 删掉
        AssemblyInfo.cs 避免特性重复定义。
  -->

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>ADOFAIMacro</AssemblyName>
    <RootNamespace>ADOFAIMacro</RootNamespace>
    <OutputType>Library</OutputType>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <!-- 保持与旧式项目一致的可空性语义：源码未做全面可空注解，
         开启 <Nullable>enable</Nullable> 会产生成百上千条与功能无关的警告。
         拆分阶段不混入这类行为变更。 -->
    <Nullable>disable</Nullable>
    <WarningLevel>4</WarningLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!--
      旧式格式逐个 <Compile Include>，天然不会扫到 obj\；SDK 默认的 **\*.cs
      通配会把 obj\ 下自己生成的 AssemblyInfo / AssemblyAttributes 也当源码收进来，
      导致 "特性重复 CS0579"。这里把中间目录移出默认项，改由下面的显式
      Compile ItemGroup 接管。
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;Backup\**</DefaultItemExcludes>
    <!-- 上面把 obj\bin 移出默认项还不够：只要默认 Compile 项仍开着，
         显式列出的文件就会被收两遍（NETSDK1022）。彻底关掉默认项，
         源文件完全由下面的显式清单决定。 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 未使用字段在 mod 里普遍存在（回退路径、平台分支），不因它噪声淹没真问题 -->
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>

  <!--
    源文件按职责分目录组织，与 JipperKeyViewer 的分层风格一致：
      Core/         入口、生命周期、Harmony 补丁
      Technique/    ★ 手法模拟核心（分片算法、事件表、原生绑定）
      Input/        按键注入、虚拟键盘、SkyHook
      Timing/       高精度时钟
      Calibration/  判定校准与诊断统计
      Settings/     设置模型与持久化
      UI/           通用 UI 工具
      Platform/     平台分支
      Localization/ 本地化

    显式列出而非用 SDK 默认通配：便于一眼看清每个目录包含什么，
    同时避免把 obj\ 下自己生成的文件当源码收进来。
  -->
  <ItemGroup Label="Core 入口与补丁">
    <Compile Include="Core\Main.cs" />
    <Compile Include="Core\Patches.cs" />
    <Compile Include="Core\GameNotifier.cs" />
    <Compile Include="Core\GameVersion.cs" />
    <Compile Include="Core\MacroPatch.cs" />
    <Compile Include="Core\MacroPatchHub.cs" />
    <Compile Include="Core\GuardFactory.cs" />
  </ItemGroup>

  <ItemGroup Label="Technique 手法模拟">
    <!-- MacroEngine.cs 是这个 partial class 的主体（字段、TimeAnchor、Win32
         声明、每帧 Update）；其余文件按职责补上，详见各文件头部注释。 -->
    <Compile Include="Technique\MacroEngine.cs" />
    <Compile Include="Technique\ConfigParser.cs" />
    <Compile Include="Technique\EventBuilder.cs" />
    <Compile Include="Technique\NativeTechnique.cs" />
    <Compile Include="Technique\PieceBuilder.cs" />
    <Compile Include="Technique\KeyWorker.cs" />
    <Compile Include="Technique\TriggerRsHost.cs" />
    <Compile Include="Technique\EmbeddedNative.cs" />
    <Compile Include="Technique\Clock.cs" />
    <Compile Include="Technique\Lifecycle.cs" />
    <Compile Include="Technique\TechniqueSimulator.cs" />
    <Compile Include="Technique\TraceFile.cs" />
    <Compile Include="Technique\TracePlayer.cs" />
    <Compile Include="Technique\AngleAsyncDriver.cs" />
    <Compile Include="Technique\DeviationProbe.cs" />
    <Compile Include="Technique\LevelTechniqueManager.cs" />
  </ItemGroup>

  <ItemGroup Label="Calibration 校准与诊断">
    <Compile Include="Calibration\Calibration.cs" />
  </ItemGroup>

  <ItemGroup Label="Input 输入">
    <Compile Include="Input\InputSystem.cs" />
    <Compile Include="Input\VirtualAsyncInput.cs" />
    <Compile Include="Input\AsyncInputManager.cs" />
    <Compile Include="Input\KeyMap.cs" />
    <Compile Include="Input\SkyHookSystem.cs" />
  </ItemGroup>

  <ItemGroup Label="Timing 计时">
    <Compile Include="Timing\PreciseNow.cs" />
    <Compile Include="Timing\DSPTimeSimulater.cs" />
  </ItemGroup>

  <ItemGroup Label="Settings / UI / Platform / Localization">
    <Compile Include="Settings\Settings.cs" />
    <Compile Include="UI\UIUtils.cs" />
    <Compile Include="UI\ShowText.cs" />
    <Compile Include="Platform\BaseSelect.cs" />
    <Compile Include="Platform\Windows.cs" />
    <Compile Include="Platform\Linux.cs" />
    <Compile Include="Localization\LocalizationManager.cs" />
  </ItemGroup>

  <!-- 程序集元数据：原在 Properties\AssemblyInfo.cs，已并入此处。 -->
  <PropertyGroup>
    <Product>ADOFAIMacro</Product>
    <!-- 1.4.0-alpha22 发布：AssemblyVersion 必须纯数字（CLR 限制），
         带后缀的版本号放 FileVersion/Version（Info.json 的 Version 由 UMM 解析，可带后缀）。 -->
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.22</FileVersion>
    <Version>1.4.0-alpha22</Version>
    <Company></Company>
    <Description></Description>
    <Copyright>Copyright ©  2026</Copyright>
    <NeutralLanguage></NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 仓库根目录（本 csproj 位于 <根>\ADOFAIMacro\ 下）。 -->
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <!-- ADOFAI 游戏 Managed 目录（按本机 Steam 安装位置调整）。
         抽成 GameManaged 属性后，Reference 里统一用 $(GameManaged)。 -->
    <GameManaged>$(RepoRoot)..\..\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice\A Dance of Fire and Ice_Data\Managed</GameManaged>
  </PropertyGroup>

  <!-- 旧式格式里每个配置各写一份；这里用条件属性组保持同样语义。 -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <!-- 不带 net481 子目录：旧式项目输出到 bin\<Cfg>\，部署脚本与
         CopyNativeDlls 目标都按那个路径找 DLL。 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <!--
    运行时依赖。System.* 那批用 PackageReference 走 NuGet（不再依赖
    packages\ 目录）；游戏与 UMM 的程序集仍按 HintPath 引用本机安装位置。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.3" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.3" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup Label="游戏程序集">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(GameManaged)\RDTools.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="SkyHook.Unity">
      <HintPath>$(GameManaged)\SkyHook.Unity.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityFileDialog">
      <HintPath>$(GameManaged)\UnityFileDialog.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="UnityModManager">
    <Reference Include="UnityModManager">
      <HintPath>$(GameManaged)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManaged)\UnityModManager\0Harmony.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="Unity 引擎">
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManaged)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameManaged)\UnityEngine.JSONSerializeModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="BCL">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup Label="内容">
    <Content Include="Localization\zh-CN.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Localization\en-US.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Rust 触发内核（TriggerRs）以嵌入资源随主 DLL 分发：
      部署面保持「一个 ADOFAIMacro.dll」，运行期由 EmbeddedNative 解压到
      %LOCALAPPDATA%\ADOFAIMacro\native\ 再 LoadLibrary（详见 EmbeddedNative.cs）。
      资源文件 = TriggerRs target release 下的 macro_trigger.dll（cargo build 产物）。
      构建前先跑 TriggerRs（见下方 BuildTriggerRs Target）。
    -->
    <EmbeddedResource Include="$(RepoRoot)TriggerRs\target\release\macro_trigger.dll">
      <LogicalName>ADOFAIMacro.Technique.macro_trigger.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

    <!--
    把原生 TechniqueSimulator.dll / InputSystem.dll 收集到统一输出目录。
    C++ 项目在仓库根的 TechniqueSimulator\ 与 InputSystem\ 下（与托管项目
    分开，因为 vcxproj 不能放进 SDK 项目的目录树里）。
    打包目录 out\<Cfg>\ 是部署布局的单一来源。
  -->
  <!--
      必须挂 PrepareResources 而不是 Build：Build 依赖 CoreBuild（编译在其内），
      BeforeTargets="Build" 实际在编译之后才执行。本机因 DLL 早已存在而不报错，
      干净检出（CI）会在 csc 读取嵌入资源时报 CS1566。
    -->
  <Target Name="BuildTriggerRs" BeforeTargets="PrepareResources" Condition="'$(Configuration)' == 'Release'">
    <!--
      构建 Rust 触发内核（TriggerRs → macro_trigger.dll）。
      仅 Release 构建（Debug 用 C# 触发路径，减少调试变量）；
      cargo 缺失时跳过并告警——嵌入资源缺失时 TriggerRsHost 会退回 C# 路径，不阻塞构建。
      镜像环境变量（RUSTUP_HOME/CARGO_HOME）沿用用户级持久变量（D:\Rust）。
    -->
    <PropertyGroup>
      <!-- 本机 Rust 装在 D:\Rust；CI 用 -p:CargoExe=<绝对路径> 覆盖。 -->
      <CargoExe Condition="'$(CargoExe)' == ''">D:\Rust\.cargo\bin\cargo.exe</CargoExe>
      <_CargoExe>$(CargoExe)</_CargoExe>
      <_TriggerRsDir>$(RepoRoot)TriggerRs</_TriggerRsDir>
      <_TriggerDll>$(_TriggerRsDir)\target\release\macro_trigger.dll</_TriggerDll>
      <!-- 仅本机自定义安装位置需要显式传 RUSTUP_HOME/CARGO_HOME；CI 用 rustup 默认环境。 -->
      <_RustEnv Condition="'$(CargoExe)' == 'D:\Rust\.cargo\bin\cargo.exe'">RUSTUP_HOME=D:\Rust\.rustup;CARGO_HOME=D:\Rust\.cargo</_RustEnv>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CargoExe)') And !Exists('$(_TriggerDll)')"
           Text="TriggerRs: 未找到 cargo（$(_CargoExe)）且无预编译 macro_trigger.dll，请安装 Rust 或手动放置 DLL" />
    <Exec Condition="Exists('$(_CargoExe)')"
          Command="&quot;$(_CargoExe)&quot; build --release"
          WorkingDirectory="$(_TriggerRsDir)"
          EnvironmentVariables="$(_RustEnv)"
          IgnoreExitCode="false" />
    <Message Condition="!Exists('$(_CargoExe)') And Exists('$(_TriggerDll)')"
             Importance="normal" Text="TriggerRs: cargo 不可用，使用既有预编译 macro_trigger.dll" />
  </Target>

  <Target Name="CopyNativeDlls" AfterTargets="Build">
    <PropertyGroup>
      <_TechSimDll>$(RepoRoot)TechniqueSimulator\x64\$(Configuration)\TechniqueSimulator.dll</_TechSimDll>
      <!-- CI 没有 v145 C++ 工具链（也编不了本机未入库的源码改动），
           回退到入库的预编译 DLL —— 与发布包内二进制一致。 -->
      <_TechSimDll Condition="!Exists('$(_TechSimDll)')">$(RepoRoot)native\prebuilt\TechniqueSimulator.dll</_TechSimDll>
      <_InputSysDll>$(RepoRoot)InputSystem\x64\$(Configuration)\InputSystem.dll</_InputSysDll>
      <_InputSysDll Condition="!Exists('$(_InputSysDll)')">$(RepoRoot)native\prebuilt\InputSystem.dll</_InputSysDll>
      <_PackDir>$(RepoRoot)out\$(Configuration)\</_PackDir>
    </PropertyGroup>

    <!-- 先落在 bin\<Cfg>\ —— 那是本项目的正常输出目录 -->
    <Copy SourceFiles="$(_TechSimDll)"  DestinationFolder="$(OutDir)" Condition="Exists('$(_TechSimDll)')" />
    <Copy SourceFiles="$(_InputSysDll)" DestinationFolder="$(OutDir)" Condition="Exists('$(_InputSysDll)')" />

    <!-- 再汇总到打包目录 -->
    <MakeDir Directories="$(_PackDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_PackDir)" />
    <!-- Info.json 在项目目录下（RepoRoot 是仓库根，之前写错导致打包目录漏掉它）。 -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Info.json" DestinationFolder="$(_PackDir)" Condition="Exists('$(MSBuildThisFileDirectory)Info.json')" />
    <Copy SourceFiles="$(OutDir)TechniqueSimulator.dll" DestinationFolder="$(_PackDir)" Condition="Exists('$(OutDir)TechniqueSimulator.dll')" />
    <Copy SourceFiles="$(OutDir)InputSystem.dll"        DestinationFolder="$(_PackDir)" Condition="Exists('$(OutDir)InputSystem.dll')" />
    <Copy SourceFiles="$(OutDir)System.Memory.dll"     DestinationFolder="$(_PackDir)" Condition="Exists('$(OutDir)System.Memory.dll')" />
    <Copy SourceFiles="Localization\zh-CN.json" DestinationFolder="$(_PackDir)Localization" />
    <Copy SourceFiles="Localization\en-US.json" DestinationFolder="$(_PackDir)Localization" />
  </Target>

</Project>
